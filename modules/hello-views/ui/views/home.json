{
  "schema": "1.0",
  "brand": {
    "name": "Hello Views",
    "icon": "layout"
  },
  "navigation": {
    "items": [
      {
        "id": "nav-perspectives",
        "label": "Perspectives",
        "icon": "layout",
        "items": [
          {
            "id": "persp-all-notes",
            "label": "All Notes",
            "icon": "notes",
            "action": {
              "type": "navigate",
              "target": "#note-table"
            }
          },
          {
            "id": "persp-my-notes",
            "label": "Assigned to Me",
            "icon": "users",
            "badge": "Mine",
            "action": {
              "type": "navigate",
              "target": "#my-notes"
            }
          },
          {
            "id": "persp-insights",
            "label": "Analytics & Insights",
            "icon": "activity",
            "action": {
              "type": "navigate",
              "target": "#note-insights"
            }
          }
        ]
      },
      {
        "id": "nav-quick-actions",
        "label": "Quick Actions",
        "icon": "sparkles",
        "items": [
          {
            "id": "act-new-note",
            "label": "Create New Note",
            "icon": "notes",
            "action": {
              "type": "navigate",
              "target": "#note-form"
            }
          },
          {
            "id": "act-new-task",
            "label": "Create Todo Task",
            "icon": "todo",
            "action": {
              "type": "navigate",
              "target": "/app/todo"
            }
          }
        ]
      },
      {
        "id": "nav-bridges",
        "label": "Related Apps",
        "icon": "modules",
        "items": [
          {
            "id": "bridge-todos",
            "label": "My Todos",
            "icon": "todo",
            "action": {
              "type": "navigate",
              "target": "/app/todo"
            }
          },
          {
            "id": "bridge-datasources",
            "label": "Data Sources Demonstration",
            "icon": "database",
            "action": {
              "type": "navigate",
              "target": "/app/hello-datasources"
            }
          },
          {
            "id": "bridge-admin",
            "label": "Admin Tools",
            "icon": "settings",
            "action": {
              "type": "navigate",
              "target": "/admin"
            }
          },
          {
            "id": "bridge-apps-hub",
            "label": "Apps Hub",
            "icon": "home",
            "action": {
              "type": "navigate",
              "target": "/"
            }
          }
        ]
      }
    ]
  },
  "page": {
    "id": "hello-views",
    "title": "Hello Views",
    "sections": [
      {
        "id": "note-insights",
        "label": "Insights",
        "type": "dashboard",
        "toolbar": [
          {
            "id": "period",
            "type": "filter",
            "field": "recordDate",
            "options": [
              {
                "label": "Today",
                "value": "today"
              },
              {
                "label": "This Week",
                "value": "this_week"
              },
              {
                "label": "This Month",
                "value": "this_month"
              },
              {
                "label": "All Time",
                "value": "all_time"
              }
            ],
            "defaultValue": "this_month"
          }
        ],
        "data": {
          "source": "hello-views.note.insights"
        },
        "config": {
          "cards": [
            {
              "id": "total",
              "label": "Total Notes",
              "accent": "indigo"
            },
            {
              "id": "completed",
              "label": "Completed",
              "accent": "emerald"
            },
            {
              "id": "pending",
              "label": "Pending",
              "accent": "amber"
            }
          ],
          "charts": []
        }
      },
      {
        "id": "note-table",
        "label": "Notes",
        "type": "table",
        "toolbar": [
          {
            "id": "new",
            "type": "action",
            "label": "New Note",
            "action": {
              "type": "create",
              "target": "hello-views.note.form"
            }
          },
          {
            "id": "search",
            "type": "search"
          },
          {
            "id": "status",
            "type": "filter",
            "field": "status",
            "options": [
              {
                "label": "Draft",
                "value": "draft"
              },
              {
                "label": "Submitted",
                "value": "submitted"
              },
              {
                "label": "Approved",
                "value": "approved"
              },
              {
                "label": "Cancelled",
                "value": "cancelled"
              }
            ]
          },
          {
            "id": "columns",
            "type": "columns"
          },
          {
            "id": "refresh",
            "type": "action",
            "label": "Refresh",
            "action": {
              "type": "refresh"
            }
          }
        ],
        "data": {
          "source": "hello-views.note"
        },
        "config": {
          "columns": [
            {
              "key": "title",
              "label": "Title",
              "type": "text",
              "sortable": true
            },
            {
              "key": "content",
              "label": "Content",
              "type": "text"
            },
            {
              "key": "category",
              "label": "Category",
              "type": "badge"
            },
            {
              "key": "assigned_to",
              "label": "Assigned To",
              "type": "text"
            },
            {
              "key": "record_date",
              "label": "Date",
              "type": "date",
              "sortable": true
            },
            {
              "key": "record_status",
              "label": "Status",
              "type": "badge",
              "sortable": true
            }
          ],
          "selectable": true,
          "pageSize": 50,
          "density": "comfortable",
          "detailView": true
        }
      },
      {
        "id": "my-notes",
        "label": "My Notes",
        "type": "table",
        "toolbar": [
          {
            "id": "new",
            "type": "action",
            "label": "New Note",
            "action": {
              "type": "create",
              "target": "hello-views.note.form"
            }
          },
          {
            "id": "search",
            "type": "search"
          },
          {
            "id": "status",
            "type": "filter",
            "field": "status",
            "options": [
              {
                "label": "Draft",
                "value": "draft"
              },
              {
                "label": "Submitted",
                "value": "submitted"
              },
              {
                "label": "Approved",
                "value": "approved"
              },
              {
                "label": "Cancelled",
                "value": "cancelled"
              }
            ]
          },
          {
            "id": "columns",
            "type": "columns"
          },
          {
            "id": "refresh",
            "type": "action",
            "label": "Refresh",
            "action": {
              "type": "refresh"
            }
          }
        ],
        "data": {
          "source": "hello-views.note",
          "params": {
            "assigned_to": "$currentuser"
          }
        },
        "config": {
          "columns": [
            {
              "key": "title",
              "label": "Title",
              "type": "text",
              "sortable": true
            },
            {
              "key": "content",
              "label": "Content",
              "type": "text"
            },
            {
              "key": "category",
              "label": "Category",
              "type": "badge"
            },
            {
              "key": "assigned_to",
              "label": "Assigned To",
              "type": "text"
            },
            {
              "key": "record_date",
              "label": "Date",
              "type": "date",
              "sortable": true
            },
            {
              "key": "record_status",
              "label": "Status",
              "type": "badge",
              "sortable": true
            }
          ],
          "selectable": true,
          "pageSize": 50,
          "density": "comfortable",
          "detailView": true
        }
      },
      {
        "id": "note-form",
        "label": "New Note",
        "type": "form",
        "toolbar": [
          {
            "id": "cancel",
            "type": "action",
            "label": "Cancel",
            "action": {
              "type": "cancel"
            }
          },
          {
            "id": "save",
            "type": "action",
            "label": "Save",
            "action": {
              "type": "submit"
            }
          },
          {
            "id": "test",
            "type": "action",
            "label": "Test",
            "action": {
              "type": "submit"
            }
          }
        ],
        "config": {
          "fields": [
            {
              "name": "title",
              "label": "Title",
              "type": "text",
              "required": true
            },
            {
              "name": "content",
              "label": "Content",
              "type": "textarea"
            },
            {
              "name": "category",
              "label": "Category",
              "type": "select",
              "options": [
                {
                  "label": "Work",
                  "value": "work"
                },
                {
                  "label": "Personal",
                  "value": "personal"
                },
                {
                  "label": "Ideas",
                  "value": "ideas"
                },
                {
                  "label": "Test",
                  "value": "test"
                }
              ]
            },
            {
              "name": "assigned_to",
              "label": "Assigned To",
              "type": "select",
              "entity": "core.user",
              "displayField": "username",
              "defaultValue": "$currentuser"
            }
          ],
          "submitAction": {
            "type": "submit",
            "target": "hello-views.note.create"
          }
        }
      }
    ]
  }
}