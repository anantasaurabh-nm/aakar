// Core schema: platform/tenancy, RBAC, module registry, audit log, and AI
// model configuration. Module-owned business entity tables (Task, and any
// future schema-driven entity) are intentionally NOT modeled here — they're
// created and queried at runtime by the entity engine
// (backend/src/core/entity-engine) from each module's schema.json, via raw
// parameterized SQL through this same Prisma client's $queryRaw/$executeRaw.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Platform / tenancy
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  auditLogs      AuditLog[]
  connections    CoreConnection[]
  moduleSettings ModuleSetting[]

  @@map("tenants")
}

model RoleDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("role_definitions")
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  email        String    @unique
  username     String    @unique
  passwordHash String
  role         String    @default("STAFF")
  isActive     Boolean   @default(true)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs      AuditLog[]
  moduleSettings ModuleSetting[]

  // Module-owned tables (e.g. todo_task.created_by) reference this id via a
  // plain scalar column with no @relation, since those tables aren't Prisma
  // models — referential integrity for those columns is an
  // application-level concern.

  @@index([tenantId])
  @@map("users")
}

// Role -> permission grants. Data-driven so the entity engine can grant
// newly-generated module permissions without a code deploy (RBAC PRD rule:
// "Roles/groups are managed by the platform/RBAC system").
model RolePermission {
  id         String @id @default(cuid())
  role       String
  permission String

  @@unique([role, permission])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Module registry (Module System PRD v2 §34)
// ---------------------------------------------------------------------------

enum ModuleType {
  native
  connector
  hybrid
}

// discovered = manifest found on disk but not yet installed.
enum ModuleRegistryStatus {
  discovered
  installed
  enabled
  disabled
}

model ModuleRegistryEntry {
  id          String                @id // module.json "id"
  name        String
  version     String
  description String?
  type        ModuleType
  surfaces    String[]
  status      ModuleRegistryStatus  @default(enabled)
  icon        String                @default("app")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@map("module_registry")
}

// ---------------------------------------------------------------------------
// Standard business-record lifecycle (Module System PRD v2 §8-9) — shared by
// every schema-driven business entity.
// ---------------------------------------------------------------------------

enum RecordStatus {
  draft
  submitted
  approved
  cancelled
  deleted
}

// ---------------------------------------------------------------------------
// Audit log — append-only (Module System PRD v2 §41)
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  entity      String
  recordId    String
  action      String
  fromStatus  RecordStatus?
  toStatus    RecordStatus?
  performedBy String?
  performedByUser User? @relation(fields: [performedBy], references: [id], onDelete: SetNull)
  performedAt DateTime @default(now())
  reason      String?
  metadata    Json?

  @@index([tenantId, entity, recordId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// AI model configuration (AI Models PRD)
// ---------------------------------------------------------------------------

enum ModelProfileName {
  light
  reasoning
}

enum ProviderId {
  openai
  gemini
  openrouter
  together
  anthropic
  nvidia
}

// active | fallback per AI Models PRD §16 (Model Fallback); disabled = a spare
// config not currently wired to anything. Deliberately NOT the generic
// entity-engine RecordStatus (draft/submitted/approved/cancelled/deleted) —
// that lifecycle has no meaning for platform-level AI configuration (§30).
enum AiModelConfigStatus {
  active
  fallback
  disabled
}

// A collection of provider/model/key configs — not a fixed one-per-profile
// record. At most one `active` and one `fallback` config per profile is
// enforced in application code (ai-configuration.controller.ts), not here.
// Each owns its own API key directly (no separate named-connection
// indirection) — encrypted at rest with CREDENTIAL_ENCRYPTION_KEY and never
// returned to clients (AI Models PRD §9-10).
model AiModelConfig {
  id              String               @id @default(cuid())
  provider        ProviderId
  model           String
  encryptedApiKey String
  profile         ModelProfileName?
  status          AiModelConfigStatus  @default(disabled)
  timeoutMs       Int                  @default(30000)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  updatedBy       String?

  @@map("ai_model_configs")
}

// ---------------------------------------------------------------------------
// Core Connectors & External Integrations Vault (Module System PRD v2 §26-27, PRD §9-10)
// ---------------------------------------------------------------------------

enum ConnectionAuthType {
  api_key
  bearer_token
  basic_auth
  oauth2
  custom
}

enum ConnectionStatus {
  active
  inactive
  error
}

model CoreConnection {
  id                   String              @id @default(cuid())
  tenantId             String
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  provider             String              // e.g. "shopify", "mygate", "slack", "sendgrid", "custom"
  name                 String              // e.g. "Production Shopify Store"
  authType             ConnectionAuthType  @default(api_key)
  baseUrl              String?
  encryptedCredentials String              // AES-256-GCM encrypted JSON payload
  maskedPreview        String?             // e.g. "shpat_••••••••3a9f" or "••••••••"
  status               ConnectionStatus    @default(active)
  lastTestedAt         DateTime?
  lastTestedStatus     String?             // "ok" | error message
  lastUsedAt           DateTime?
  metadata             Json?               // Non-secret metadata
  createdBy            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([tenantId, provider, name])
  @@index([tenantId, provider])
  @@map("core_connections")
}

// ---------------------------------------------------------------------------
// Module Settings (Module-level configuration with user/global scopes)
// ---------------------------------------------------------------------------

model ModuleSetting {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleId  String   // e.g. "todo", "crm"
  userId    String?  // null for global/tenant-wide settings
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   // e.g. "mcpTaskServer", "trelloSyncConnection"
  value     Json     // connection ID, string, number, boolean, or object
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, moduleId, userId, key])
  @@index([tenantId, moduleId, userId])
  @@map("module_settings")
}

